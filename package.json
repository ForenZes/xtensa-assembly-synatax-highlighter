{
  "name": "xtensa-assembly-highlighter",
  "displayName": "Xtensa Assembly Syntax Highlighter For ESP32, ESP32-S2, and ESP32-S3",
  "description": "Syntax highlighting for Xtensa GNU assembly, aimed at ESP32, ESP32-S2 and ESP32-S3.",
  "version": "0.4.0",
  "publisher": "ForenZesLabs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "xtensa",
    "esp32",
    "esp32-s2",
    "esp32-s3",
    "assembly",
    "assembler",
    "gas",
    "gnu assembler"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xtensa-asm",
        "aliases": [
          "Xtensa Assembly",
          "Xtensa ASM"
        ],
        "extensions": [
          ".s",
          ".S"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xtensa-asm",
        "scopeName": "source.xtensa-asm",
        "path": "./syntaxes/xtensa.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xtensa-asm",
        "path": "./snippets/xtensa.json"
      }
    ]
  },
  "author": {
    "name": "ForenZes Labs",
    "url": "https://forenzes.com"
  },
  "homepage": "https://forenzes.com",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ForenZes/xtensa-assembly-synatax-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/ForenZes/xtensa-assembly-synatax-highlighter/issues"
  }
}
