{
  "Function (call0 ABI)": {
    "prefix": "xtfunc",
    "body": [
      ".section .text",
      ".global ${1:function_name}",
      ".type ${1:function_name}, @function",
      ".align 4",
      "${1:function_name}:",
      "    ${0:nop}",
      ".size ${1:function_name}, .-${1:function_name}"
    ],
    "description": "Create an Xtensa GNU assembly function"
  },
  "Save a0/a12-a15": {
    "prefix": "xtsavecall0",
    "body": [
      "addi a1, a1, -32",
      "s32i a0,  a1, 0",
      "s32i a12, a1, 4",
      "s32i a13, a1, 8",
      "s32i a14, a1, 12",
      "s32i a15, a1, 16"
    ],
    "description": "Save call0 callee-saved registers"
  },
  "Restore a0/a12-a15": {
    "prefix": "xtrestorecall0",
    "body": [
      "l32i a0,  a1, 0",
      "l32i a12, a1, 4",
      "l32i a13, a1, 8",
      "l32i a14, a1, 12",
      "l32i a15, a1, 16",
      "addi a1, a1, 32"
    ],
    "description": "Restore call0 callee-saved registers"
  }
}
